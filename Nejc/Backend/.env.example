BUDDY_PORT=43123
# Relativne poti se razresijo glede na mapo Nejc.
BUDDY_WORKSPACE=./workspace
BUDDY_DATA=./data
# Ustvari dolgo nakljucno vrednost. Ce je prazno, jo backend ustvari ob vsakem zagonu.
BUDDY_TOKEN=
# Lokalni pogovor, brez placljivega API ali racuna.
# Za demonstracijo brez AI lahko nastavis mock.
BUDDY_AI_PROVIDER=ollama
BUDDY_OLLAMA_URL=http://127.0.0.1:11434
BUDDY_OLLAMA_MODEL=qwen3:8b
# Pomnilnik: kontekst modela (vecji = vec RAM za KV cache, daljsi spomin pogovora).
BUDDY_OLLAMA_NUM_CTX=4096
# Koliko casa ostane model v RAM po zadnjem sporocilu (npr. 30s, 2m, 0 = takoj sprosti).
BUDDY_OLLAMA_KEEP_ALIVE=2m
# Dodatne obstojece lokalne mape; setup:local doda namizje, dokumente in prenose.
BUDDY_FOLDERS={}
# Locena spletna stran s prijavo in prenosom.
WEB_PORT=43124
