BUDDY_PORT=43123
# Relativne poti se razresijo glede na mapo Nejc.
BUDDY_WORKSPACE=./workspace
BUDDY_DATA=./data
# Ustvari dolgo nakljucno vrednost. Ce je prazno, jo backend ustvari ob vsakem zagonu.
